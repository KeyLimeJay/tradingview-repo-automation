# Bosonic FIX API Connection Settings
BOSONIC_HOST=fix.bosonic.com
BOSONIC_PORT=18305
BOSONIC_SENDER_COMP_ID=KUROSHIO_PRICE_FEED_MD
BOSONIC_TARGET_COMP_ID=OGG_MD_KUROSHIO_PRICE_FEED

# Trading pairs to monitor - comma-separated list
TRADING_PAIRS=EUR/USD,BTC/USD,ETH/USD

# Logging settings
LOG_LEVEL=INFO
LOG_FILE=bosonic_fix_client.log